{
	"name": "kemek/qr",
	"short_name": "kemek/qr",
	"description": "Free QR code generator. No signup, no tracking, no upload. Runs entirely in your browser.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"orientation": "portrait",
	"background_color": "#f2ebdd",
	"theme_color": "#c53a1f",
	"icons": [
		{
			"src": "/favicon.svg",
			"type": "image/svg+xml",
			"sizes": "any"
		},
		{
			"src": "/favicon-192.png",
			"sizes": "192x192",
			"type": "image/png"
		},
		{
			"src": "/favicon-512.png",
			"sizes": "512x512",
			"type": "image/png"
		},
		{
			"src": "/apple-touch-icon.png",
			"sizes": "180x180",
			"type": "image/png"
		}
	]
}
