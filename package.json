		"@types/node": "^25.9.12",
		"@vitest/ui": "^4.1.5",
		"jsdom": "^29.1.1",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^3.5.2",
		"sharp": "^0.34.5",
		"svelte": "^5.59.2",
		"svelte-check": "^4.7.8",
		"to-ico": "^1.1.5",
		"typescript": "^6.0.3",
		"vite": "^8.3.8",
		"vitest": "^4.1.5"
	},
	"dependencies": {
		"@fontsource-variable/fraunces": "^5.3.0",
